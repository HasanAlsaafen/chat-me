# Default: relative paths. Vite's dev server proxies /api and /socket.io to
# https://chat-me.app (see vite.config.ts), so the browser never makes a
# cross-origin request and the backend's CORS allow-list is never hit.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=

# If you're running the backend locally instead (npm run start:dev in
# chat-me-server, or docker compose up), point directly at it and remove
# the proxy entries in vite.config.ts (same-origin, no CORS issue either way):
# VITE_API_URL=http://localhost:3000/api/v1
# VITE_SOCKET_URL=http://localhost:3000

# Set to "true" to take the whole app down and route every route to the
# maintenance page instead (see src/features/maintenance/MaintenancePage.tsx).
VITE_MAINTENANCE_MODE=false
